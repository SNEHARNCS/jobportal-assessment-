PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Option A: Use DATABASE_URL (Render PostgreSQL - recommended)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: Individual fields (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=hirehub
DB_SSL=false

MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
TRUST_PROXY=
ALLOW_ADMIN_BOOTSTRAP=false
